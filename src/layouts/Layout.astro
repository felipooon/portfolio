---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Felipe Godoy Pérez — Desarrollo Web & Hardware",
  description = "Portafolio de Felipe Godoy Pérez: aplicaciones web con Django y Astro, comercio electrónico, cartografía en tiempo real y hardware en terreno."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2216%22 fill=%22%2316181d%22/><text y=%2268%22 x=%2250%22 font-family=%22monospace%22 font-weight=%22700%22 font-size=%2250%22 fill=%22%23f0eee9%22 text-anchor=%22middle%22>FG</text></svg>" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  
  <script is:inline>
    (function() {
      const storedTheme = localStorage.getItem('portfolio-theme');
      if (storedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
<body>
  <!-- NAVEGACIÓN SUPERIOR SOBRIA Y TÉCNICA -->
  <header class="site-header">
    <div class="nav-container">
      <a href="#" class="brand-link">
        <span class="brand-name">Felipe Godoy Pérez</span>
        <span class="brand-loc">Puerto Montt, CL</span>
      </a>

      <nav class="nav-menu">
        <a href="#proyectos">Proyectos</a>
        <a href="#tecnologias">Tecnologías</a>
        <a href="#archivo">Archivo</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <div class="nav-controls">
        <button id="theme-toggle-btn" class="theme-toggle" type="button" aria-label="Cambiar tema de color" title="Alternar modo claro / oscuro">
          <span class="mode-text-dark">Modo Claro</span>
          <span class="mode-text-light">Modo Oscuro</span>
        </button>
      </div>
    </div>
  </header>

  <main class="page-container">
    <slot />
  </main>

  <!-- TOAST DE COPIA AL PORTAPAPELES -->
  <div id="copy-toast" class="copy-toast" role="status" aria-live="polite">
    <span class="toast-bullet">•</span>
    <span id="toast-text">felipegp90@gmail.com copiado</span>
  </div>

  <script>
    function setupThemeToggle() {
      const toggleBtn = document.getElementById('theme-toggle-btn');
      if (!toggleBtn) return;

      toggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
        if (isDark) {
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('portfolio-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('portfolio-theme', 'dark');
        }
      });
    }

    function setupCopyEmail() {
      const copyButtons = document.querySelectorAll('[data-copy-email]');
      const toast = document.getElementById('copy-toast');
      const toastText = document.getElementById('toast-text');
      let timeoutId: number;

      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const email = (btn as HTMLElement).dataset.copyEmail || 'felipegp90@gmail.com';
          try {
            await navigator.clipboard.writeText(email);
            if (toast && toastText) {
              toastText.textContent = `${email} copiado al portapapeles`;
              toast.classList.add('show');
              clearTimeout(timeoutId);
              timeoutId = window.setTimeout(() => {
                toast.classList.remove('show');
              }, 2800);
            }
          } catch (err) {
            window.location.href = `mailto:${email}`;
          }
        });
      });
    }

    setupThemeToggle();
    setupCopyEmail();
    document.addEventListener('astro:page-load', () => {
      setupThemeToggle();
      setupCopyEmail();
    });
  </script>
</body>
</html>

<style is:global>
  :root {
    /* MODO OSCURO (ESTÉTICA TÉCNICO-EDITORIAL REFINADA) */
    --bg: #101114;
    --surface: #16181d;
    --surface-card: #1a1d24;
    --surface-hover: #22262f;
    
    --text: #eeece8;
    --text-soft: #b6b4ad;
    --text-muted: #727680;
    
    --border: #262932;
    --border-strong: #383d49;
    --border-hover: #4e5566;
    
    --accent: #d85c44; /* Terracota sobrio */
    --accent-hover: #eb6f57;
    
    --font-serif: 'Newsreader', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  [data-theme="light"] {
    /* MODO CLARO (PAPEL REFINADO / INGENIERÍA) */
    --bg: #f6f5f0;
    --surface: #eceae3;
    --surface-card: #ffffff;
    --surface-hover: #f1efea;
    
    --text: #191b1f;
    --text-soft: #44474e;
    --text-muted: #767a83;
    
    --border: #dcd9d0;
    --border-strong: #bbb7ab;
    --border-hover: #8f8a7e;
    
    --accent: #b8432c;
    --accent-hover: #9e3621;
  }

  html {
    scroll-behavior: smooth;
    color-scheme: dark;
  }

  [data-theme="light"] {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* NAVEGACIÓN SUPERIOR */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text);
  }

  .brand-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }

  .brand-loc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .nav-menu {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .nav-menu a {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-menu a:hover {
    color: var(--text);
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-soft);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .mode-text-light {
    display: none;
  }

  [data-theme="light"] .mode-text-dark {
    display: none;
  }

  [data-theme="light"] .mode-text-light {
    display: inline;
  }

  /* CONTENEDOR PRINCIPAL */
  .page-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem 1.5rem;
  }

  /* ESTRUCTURA DE SECCIÓN SOBRIA */
  section {
    margin-bottom: 5.5rem;
  }

  .section-label-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .section-meta-id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* TOAST NOTIFICACIÓN */
  .copy-toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--surface);
    color: var(--text);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 10000;
    transform: translateY(150%);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
    pointer-events: none;
  }

  .copy-toast.show {
    transform: translateY(0);
    opacity: 1;
  }

  .toast-bullet {
    color: var(--accent);
    font-size: 1.1rem;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .nav-menu { display: none; }
    .page-container { padding-top: 2rem; }
    .section-heading { font-size: 1.4rem; }
  }
</style>
