---
---

<section id="contacto" class="contact-block">
  <div class="section-label-bar">
    <h2 class="section-heading">Contacto</h2>
    <span class="section-meta-id">[ Mensaje Directo ]</span>
  </div>

  <div class="contact-layout">
    <!-- COLUMNA LATERAL: DATOS DIRECTOS -->
    <div class="contact-sidebar">
      <p class="sidebar-intro">
        Si te interesa colaborar en algún desarrollo web, aplicaciones con Django o Astro, o proyectos de hardware en terreno, puedes escribirme directamente o utilizar el formulario.
      </p>

      <div class="contact-links-list">
        <div class="contact-row">
          <span class="row-label">Correo</span>
          <div class="row-action">
            <a href="mailto:felipegp90@gmail.com" class="row-link">felipegp90@gmail.com</a>
            <button class="mini-copy-btn" data-copy-email="felipegp90@gmail.com" type="button" title="Copiar correo">
              [Copiar]
            </button>
          </div>
        </div>

        <div class="contact-row">
          <span class="row-label">GitHub</span>
          <a href="https://github.com/felipooon" target="_blank" rel="noopener" class="row-link">
            github.com/felipooon &rarr;
          </a>
        </div>

        <div class="contact-row">
          <span class="row-label">Ubicación</span>
          <span class="row-text">Puerto Montt, Región de Los Lagos, Chile</span>
        </div>
      </div>
    </div>

    <!-- COLUMNA FORMULARIO -->
    <div class="contact-form-pane">
      <form id="portfolio-contact-form" class="clean-form" novalidate>
        <div class="form-grid-2">
          <div class="field-item">
            <label for="contact-name" class="field-label">Nombre *</label>
            <input 
              type="text" 
              id="contact-name" 
              name="name" 
              required 
              placeholder="Tu nombre" 
              class="field-input" 
            />
            <span class="error-msg" id="name-error">Campo requerido</span>
          </div>

          <div class="field-item">
            <label for="contact-email" class="field-label">Correo electrónico *</label>
            <input 
              type="email" 
              id="contact-email" 
              name="email" 
              required 
              placeholder="tu@correo.com" 
              class="field-input" 
            />
            <span class="error-msg" id="email-error">Ingresa un correo válido</span>
          </div>
        </div>

        <div class="field-item">
          <label for="contact-subject" class="field-label">Asunto / Motivo</label>
          <select id="contact-subject" name="subject" class="field-select">
            <option value="Desarrollo Web / Django">Desarrollo Web (Astro / Django)</option>
            <option value="Comercio Electrónico">Comercio Electrónico / Tienda Online</option>
            <option value="Cartografía & Datos">Cartografía &amp; Visualización de Datos</option>
            <option value="Hardware / IoT en Terreno">Hardware Embebido (RP2040 / ESP32)</option>
            <option value="Consulta General">Consulta general u otra colaboración</option>
          </select>
        </div>

        <div class="field-item">
          <label for="contact-message" class="field-label">Mensaje *</label>
          <textarea 
            id="contact-message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Escribe tu mensaje..."
            class="field-textarea"
          ></textarea>
          <span class="error-msg" id="message-error">Por favor ingresa un mensaje</span>
        </div>

        <div class="form-bottom-row">
          <button type="submit" id="contact-submit-btn" class="form-btn">
            <span class="btn-text">Enviar mensaje</span>
            <span class="loading-dot">...</span>
          </button>
        </div>
      </form>

      <!-- NOTA DE CONFIRMACIÓN DISCRETA -->
      <div id="contact-success-state" class="success-notice" style="display: none;">
        <h4 class="notice-title">Mensaje enviado</h4>
        <p class="notice-text">
          Gracias por escribir, <strong id="success-user-name"></strong>. Me comunicaré a <strong id="success-user-email"></strong> a la brevedad.
        </p>
        <div class="notice-actions">
          <a id="success-mailto-btn" href="#" class="notice-mailto-link">
            Abrir copia en tu cliente de correo &rarr;
          </a>
          <button type="button" id="success-reset-btn" class="notice-reset-btn">
            Redactar otro mensaje
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('portfolio-contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit-btn');
    const successState = document.getElementById('contact-success-state');
    const resetBtn = document.getElementById('success-reset-btn');
    const mailtoBtn = document.getElementById('success-mailto-btn') as HTMLAnchorElement | null;

    if (!form || !submitBtn || !successState) return;

    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const subjectInput = document.getElementById('contact-subject') as HTMLSelectElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const messageError = document.getElementById('message-error');

    function validate(): boolean {
      let isValid = true;

      if (!nameInput.value.trim()) {
        nameInput.classList.add('invalid');
        if (nameError) nameError.style.display = 'block';
        isValid = false;
      } else {
        nameInput.classList.remove('invalid');
        if (nameError) nameError.style.display = 'none';
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(emailInput.value.trim())) {
        emailInput.classList.add('invalid');
        if (emailError) emailError.style.display = 'block';
        isValid = false;
      } else {
        emailInput.classList.remove('invalid');
        if (emailError) emailError.style.display = 'none';
      }

      if (!messageInput.value.trim()) {
        messageInput.classList.add('invalid');
        if (messageError) messageError.style.display = 'block';
        isValid = false;
      } else {
        messageInput.classList.remove('invalid');
        if (messageError) messageError.style.display = 'none';
      }

      return isValid;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validate()) return;

      submitBtn.classList.add('is-loading');
      submitBtn.setAttribute('disabled', 'true');

      const nameVal = nameInput.value.trim();
      const emailVal = emailInput.value.trim();
      const subjectVal = subjectInput.value;
      const messageVal = messageInput.value.trim();

      const mailtoSubject = encodeURIComponent(`[Contacto] ${subjectVal} - ${nameVal}`);
      const mailtoBody = encodeURIComponent(`De: ${nameVal} <${emailVal}>\nAsunto: ${subjectVal}\n\n${messageVal}`);
      if (mailtoBtn) {
        mailtoBtn.href = `mailto:felipegp90@gmail.com?subject=${mailtoSubject}&body=${mailtoBody}`;
      }

      setTimeout(() => {
        submitBtn.classList.remove('is-loading');
        submitBtn.removeAttribute('disabled');

        const successName = document.getElementById('success-user-name');
        const successEmail = document.getElementById('success-user-email');

        if (successName) successName.textContent = nameVal;
        if (successEmail) successEmail.textContent = emailVal;

        form.style.display = 'none';
        successState.style.display = 'block';
      }, 400);
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        form.reset();
        form.style.display = 'block';
        successState.style.display = 'none';
      });
    }

    [nameInput, emailInput, messageInput].forEach((input) => {
      if (!input) return;
      input.addEventListener('input', () => {
        input.classList.remove('invalid');
        const err = input.parentElement?.querySelector('.error-msg') as HTMLElement;
        if (err) err.style.display = 'none';
      });
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

<style>
  .contact-block {
    margin-bottom: 4rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3rem;
  }

  .sidebar-intro {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-soft);
    margin-bottom: 2rem;
  }

  .contact-links-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .row-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .row-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .row-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .row-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .mini-copy-btn {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
  }

  .mini-copy-btn:hover {
    color: var(--text);
  }

  .row-text {
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  /* FORMULARIO */
  .clean-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2rem;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .field-input,
  .field-select,
  .field-textarea {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    transition: border-color 0.15s ease;
  }

  .field-input:focus,
  .field-select:focus,
  .field-textarea:focus {
    outline: none;
    border-color: var(--text);
  }

  .field-input.invalid,
  .field-textarea.invalid {
    border-color: #ef4444;
  }

  .error-msg {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #ef4444;
    display: none;
  }

  .field-textarea {
    resize: vertical;
  }

  .form-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--text);
    color: var(--bg);
    border: 1px solid var(--text);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.6rem 1.35rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .form-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .loading-dot {
    display: none;
  }

  .form-btn.is-loading .loading-dot {
    display: inline;
  }

  /* NOTA DE ÉXITO */
  .success-notice {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2rem;
  }

  .notice-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .notice-text {
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .notice-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .notice-mailto-link {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
  }

  .notice-mailto-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .notice-reset-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.82rem;
    cursor: pointer;
    text-decoration: underline;
  }

  .notice-reset-btn:hover {
    color: var(--text);
  }

  @media (max-width: 820px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
