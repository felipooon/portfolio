---
---

<div id="lightbox" class="lightbox-modal">
  <div class="lightbox-content">
    <div class="lightbox-topbar">
      <span id="lightbox-title">Lámina de Inspección</span>
      <button class="lightbox-close" id="lightbox-close-btn" type="button" aria-label="Cerrar">[ Cerrar ESC &times; ]</button>
    </div>
    <div class="lightbox-img-wrap">
      <img id="lightbox-img" src="" alt="Captura ampliada" />
    </div>
    <div class="lightbox-footer">
      <span id="lightbox-footnote">Archivo de imagen original &bull; Formato de alta resolución</span>
      <a id="lightbox-link" href="#" target="_blank" rel="noopener">Visitar sitio web oficial &rarr;</a>
    </div>
  </div>
</div>

<style>
  .lightbox-modal {
    position: fixed;
    inset: 0;
    background: rgba(22, 19, 16, 0.88);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .lightbox-modal.active {
    display: flex;
    opacity: 1;
  }

  .lightbox-content {
    background: var(--bg);
    border: 1px solid var(--border-dark);
    max-width: 1040px;
    width: 100%;
    padding: 1.25rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
    position: relative;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .lightbox-close {
    background: none;
    border: 1px solid var(--border-dark);
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    color: var(--text);
    transition: all 0.15s ease;
  }

  .lightbox-close:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .lightbox-img-wrap {
    width: 100%;
    max-height: 72vh;
    overflow-y: auto;
    border: 1px solid var(--border-dark);
    background: #111;
  }

  .lightbox-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lightbox-footer {
    margin-top: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .lightbox-footer a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 600px) {
    .lightbox-footer {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>

<script>
  function setupLightbox() {
    const modal = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const titleElem = document.getElementById('lightbox-title');
    const linkElem = document.getElementById('lightbox-link') as HTMLAnchorElement | null;
    const closeBtn = document.getElementById('lightbox-close-btn');

    if (!modal || !img || !titleElem || !linkElem) return;

    function open(src: string, title: string, url: string) {
      if (!modal || !img || !titleElem || !linkElem) return;
      img.src = src;
      titleElem.textContent = title;
      linkElem.href = url;
      linkElem.textContent = 'Visitar ' + url.replace(/^https?:\/\//, '') + ' \u2192';

      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!modal) return;
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    // Attach click to all plate mattes
    document.querySelectorAll('[data-lightbox-src]').forEach((elem) => {
      const el = elem as HTMLElement;
      const src = el.dataset.lightboxSrc || '';
      const title = el.dataset.lightboxTitle || '';
      const url = el.dataset.lightboxUrl || '';

      const handleOpen = () => open(src, title, url);
      el.addEventListener('click', handleOpen);
      el.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleOpen();
        }
      });
    });

    closeBtn?.addEventListener('click', close);

    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === modal) {
        close();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        close();
      }
    });
  }

  // Setup on page load or client swap
  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
