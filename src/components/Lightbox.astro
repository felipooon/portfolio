---
---

<div id="lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
  <div class="lightbox-dialog">
    <div class="lightbox-head">
      <div class="head-text">
        <h3 id="lightbox-title">Detalle del proyecto</h3>
        <span id="lightbox-domain-tag" class="domain-tag"></span>
      </div>
      <button class="lightbox-close-btn" id="lightbox-close-btn" type="button" aria-label="Cerrar ventana">
        Cerrar [ESC]
      </button>
    </div>

    <div class="lightbox-preview">
      <img id="lightbox-img" src="" alt="Captura de pantalla del proyecto" />
    </div>

    <div class="lightbox-meta">
      <p id="lightbox-desc" class="lightbox-desc-text"></p>
      <div id="lightbox-tech" class="lightbox-tech-text"></div>
    </div>

    <div class="lightbox-foot">
      <a id="lightbox-repo" href="#" target="_blank" rel="noopener" class="lightbox-action-link">
        Ver código en GitHub &rarr;
      </a>
      <a id="lightbox-link" href="#" target="_blank" rel="noopener" class="lightbox-primary-btn">
        Visitar sitio web oficial &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .lightbox-modal {
    position: fixed;
    inset: 0;
    background: rgba(10, 11, 14, 0.85);
    backdrop-filter: blur(6px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .lightbox-modal.active {
    display: flex;
  }

  .lightbox-dialog {
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    max-width: 960px;
    width: 100%;
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .lightbox-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    gap: 1rem;
  }

  #lightbox-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
  }

  .domain-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .lightbox-close-btn {
    background: transparent;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-soft);
    padding: 0.35rem 0.65rem;
    border-radius: 3px;
    cursor: pointer;
  }

  .lightbox-close-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .lightbox-preview {
    max-height: 55vh;
    overflow-y: auto;
    border: 1px solid var(--border);
    background: #000;
    margin-bottom: 1rem;
  }

  .lightbox-preview img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lightbox-meta {
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    margin-bottom: 1rem;
  }

  .lightbox-desc-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-soft);
    margin-bottom: 0.4rem;
  }

  .lightbox-tech-text {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .lightbox-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lightbox-action-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .lightbox-action-link:hover {
    color: var(--text);
    border-color: var(--text);
  }

  .lightbox-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--text);
    color: var(--bg);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.45rem 0.95rem;
    border-radius: 3px;
  }

  .lightbox-primary-btn:hover {
    background: var(--accent);
    color: #fff;
  }

  @media (max-width: 600px) {
    .lightbox-foot {
      flex-direction: column;
      align-items: stretch;
    }
    .lightbox-primary-btn {
      justify-content: center;
    }
  }
</style>

<script>
  function setupLightbox() {
    const modal = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const titleElem = document.getElementById('lightbox-title');
    const domainElem = document.getElementById('lightbox-domain-tag');
    const descElem = document.getElementById('lightbox-desc');
    const techElem = document.getElementById('lightbox-tech');
    const linkElem = document.getElementById('lightbox-link') as HTMLAnchorElement | null;
    const repoElem = document.getElementById('lightbox-repo') as HTMLAnchorElement | null;
    const closeBtn = document.getElementById('lightbox-close-btn');

    if (!modal || !img || !titleElem) return;

    function open(src: string, title: string, url: string, desc: string, tech: string, repo: string, domain: string) {
      if (!modal || !img || !titleElem) return;
      img.src = src;
      titleElem.textContent = title;
      if (domainElem) domainElem.textContent = domain ? `[ ${domain} ]` : '';
      if (descElem) descElem.textContent = desc;
      if (techElem) techElem.textContent = tech ? `Stack: ${tech}` : '';

      if (linkElem) linkElem.href = url;

      if (repoElem) {
        if (repo) {
          repoElem.href = repo;
          repoElem.style.display = 'inline-block';
        } else {
          repoElem.style.display = 'none';
        }
      }

      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!modal) return;
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-lightbox-src]').forEach((elem) => {
      const el = elem as HTMLElement;
      const src = el.dataset.lightboxSrc || '';
      const title = el.dataset.lightboxTitle || '';
      const url = el.dataset.lightboxUrl || '';
      const desc = el.dataset.lightboxDesc || '';
      const tech = el.dataset.lightboxTech || '';
      const repo = el.dataset.lightboxRepo || '';
      const domain = el.dataset.lightboxDomain || '';

      const handleOpen = () => open(src, title, url, desc, tech, repo, domain);
      el.addEventListener('click', handleOpen);
      el.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleOpen();
        }
      });
    });

    closeBtn?.addEventListener('click', close);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) close();
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
