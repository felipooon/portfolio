<footer>
  <span>&copy; {new Date().getFullYear()} Felipe Godoy Pérez &mdash; Catálogo &amp; Archivo Técnico</span>
  <div>
    <a href="https://github.com/felipooon" target="_blank" rel="noopener">github.com/felipooon &rarr;</a>
  </div>
</footer>

<style>
  footer {
    border-top: 2px solid var(--text);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  footer a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-dark);
    padding-bottom: 1px;
  }

  footer a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 768px) {
    footer { flex-direction: column; gap: 1rem; align-items: flex-start; }
  }
</style>
