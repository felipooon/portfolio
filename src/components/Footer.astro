---
---

<footer class="site-footer">
  <div class="footer-wrap">
    <div class="footer-info">
      <span class="footer-author">&copy; {new Date().getFullYear()} Felipe Godoy Pérez</span>
      <span class="footer-sep">&bull;</span>
      <span class="footer-city">Puerto Montt, Chile</span>
    </div>

    <div class="footer-right">
      <a href="https://github.com/felipooon" target="_blank" rel="noopener" class="footer-link">
        github.com/felipooon &rarr;
      </a>
      <a href="#" class="footer-top-link">
        Volver arriba &uarr;
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-sep {
    color: var(--border-strong);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-link,
  .footer-top-link {
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover,
  .footer-top-link:hover {
    color: var(--text);
  }
</style>
