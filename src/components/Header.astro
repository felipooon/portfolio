<header class="editorial-header">
  <div class="meta-top">
    <div class="status-indicator">
      <span class="status-pulse-dot"></span>
      <span class="status-text">DISPONIBLE PARA PROYECTOS &amp; CONSULTORÍA</span>
    </div>
    
    <div class="meta-coords">
      <span class="meta-pill">Edición 2026</span>
      <span>Puerto Montt, CL &bull; 41°28′ S</span>
      <span class="clock-wrap">&bull; <span id="pm-clock">--:--:--</span> CLST</span>
    </div>
  </div>

  <div class="title-block">
    <h1>Felipe Godoy Pérez</h1>
    <p class="role-title">Ingeniería Web, Arquitectura Backend &amp; Sistemas de Campo</p>
  </div>

  <p class="intro-text">
    Compilación de sistemas en producción y arquitecturas de software: aplicaciones de comercio digital, plataformas reactivas con Astro y Django, módulos cartográficos de telemetría geoespacial en tiempo real, e integración de hardware pasivo para bioacústica y monitoreo ambiental.
  </p>

  <!-- BARRA DE ACCIÓN RÁPIDA -->
  <div class="quick-actions-bar">
    <button class="action-btn primary-action" data-copy-email="felipegp90@gmail.com" type="button" title="Copiar correo electrónico de contacto">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
      <span>felipegp90@gmail.com</span>
      <span class="action-tag">Copiar 📋</span>
    </button>

    <a href="https://github.com/felipooon" target="_blank" rel="noopener" class="action-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      <span>github.com/felipooon</span>
      <span class="action-tag">&rarr;</span>
    </a>

    <a href="#contacto" class="action-btn link-action">
      <span>§ Ficha de Contacto</span>
      <span class="action-tag">&darr;</span>
    </a>
  </div>

  <!-- ESCALA TÉCNICA EDITORIAL -->
  <div class="technical-ruler" aria-hidden="true">
    <span class="ruler-notch notch-0">00</span>
    <span class="ruler-line"></span>
    <span class="ruler-notch notch-25">25</span>
    <span class="ruler-line"></span>
    <span class="ruler-notch notch-50">50</span>
    <span class="ruler-line"></span>
    <span class="ruler-notch notch-75">75</span>
    <span class="ruler-line"></span>
    <span class="ruler-notch notch-100">100% REGISTRO</span>
  </div>
</header>

<script>
  function updateClock() {
    const clock = document.getElementById('pm-clock');
    if (!clock) return;
    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('es-CL', {
        timeZone: 'America/Santiago',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      });
      clock.textContent = formatter.format(now);
    } catch (e) {
      // Fallback a hora local
      const now = new Date();
      clock.textContent = now.toTimeString().split(' ')[0];
    }
  }

  updateClock();
  setInterval(updateClock, 1000);
</script>

<style>
  .editorial-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--text);
  }

  .meta-top {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.6rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: status-pulse 2s infinite cubic-bezier(0.66, 0, 0, 1);
  }

  @keyframes status-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .meta-coords {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-pill {
    font-size: 0.65rem;
    border: 1px solid var(--border-dark);
    padding: 0.15rem 0.5rem;
    background: var(--badge-bg);
    color: var(--text);
  }

  .clock-wrap {
    color: var(--accent);
  }

  .title-block {
    margin-bottom: 1.25rem;
  }

  h1 {
    font-family: var(--font-title);
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.12;
    margin-bottom: 0.45rem;
    color: var(--text);
  }

  .role-title {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .intro-text {
    font-size: 1.08rem;
    color: var(--text-soft);
    max-width: 820px;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  /* BARRA DE ACCIONES RÁPIDAS */
  .quick-actions-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border-dark);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: var(--surface-matte);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--shadow-color);
  }

  .primary-action {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--surface);
  }

  .primary-action:hover {
    background: var(--accent);
    color: #fff;
  }

  .primary-action:hover .action-tag {
    background: rgba(0, 0, 0, 0.2);
    color: #fff;
  }

  .action-tag {
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  /* REGLA TÉCNICA */
  .technical-ruler {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    opacity: 0.75;
    user-select: none;
    margin-top: 0.5rem;
  }

  .ruler-line {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      var(--border-dark),
      var(--border-dark) 4px,
      transparent 4px,
      transparent 8px
    );
  }

  .ruler-notch {
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    h1 { font-size: 2rem; }
    .role-title { font-size: 1rem; }
    .meta-top { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
    .quick-actions-bar { flex-direction: column; width: 100%; }
    .action-btn { width: 100%; justify-content: space-between; }
    .technical-ruler { display: none; }
  }
</style>
