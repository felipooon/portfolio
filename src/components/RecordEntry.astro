---
import type { TechnicalRecord } from '../data/projects';

interface Props {
  record: TechnicalRecord;
}

const { record } = Astro.props;
---

<article 
  class:list={["record-item", "record-entry", { "featured-record": record.featured }]} 
  data-category-key={record.categoryKey}
>
  <div class="record-info">
    <div class="record-meta-line">
      <span class="record-tagline">{record.tagline}</span>
      <span class="record-status">{record.statusBadge}</span>
    </div>

    <h3 class="record-name">
      {record.repoUrl ? (
        <a href={record.repoUrl} target="_blank" rel="noopener">
          {record.title}
          <span class="link-arrow">&rarr;</span>
        </a>
      ) : (
        record.title
      )}
    </h3>

    <p class="record-body">{record.description}</p>

    <div class="specs-list">
      {record.specs.map((s) => (
        <span class="spec-tag">{s}</span>
      ))}
    </div>
  </div>

  {record.repoUrl && (
    <div class="record-aside">
      <a href={record.repoUrl} target="_blank" rel="noopener" class="repo-button">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>Repositorio</span>
      </a>
    </div>
  )}
</article>

<style>
  .record-item {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    transition: border-color 0.2s ease;
  }

  .record-item:hover {
    border-color: var(--border-strong);
  }

  .featured-record {
    border-left: 3px solid var(--text-soft);
  }

  .record-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .record-meta-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .record-status {
    color: var(--text-soft);
  }

  .record-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.45rem;
  }

  .record-name a {
    color: var(--text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.15s ease;
  }

  .record-name a:hover {
    color: var(--accent);
  }

  .link-arrow {
    font-size: 1.1rem;
    line-height: 1;
  }

  .record-body {
    font-size: 0.92rem;
    color: var(--text-soft);
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 800px;
  }

  .specs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  .record-aside {
    flex-shrink: 0;
  }

  .repo-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    color: var(--text-soft);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.45rem 0.85rem;
    border-radius: 3px;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .repo-button:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--surface);
  }

  @media (max-width: 768px) {
    .record-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.25rem;
    }
    .record-aside {
      width: 100%;
    }
    .repo-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
