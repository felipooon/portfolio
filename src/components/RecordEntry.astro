---
import type { TechnicalRecord } from '../data/projects';

interface Props {
  record: TechnicalRecord;
}

const { record } = Astro.props;
---

<article class:list={["record-entry", { featured: record.featured }]}>
  <div class="record-meta">
    <h3>
      {record.repoUrl ? (
        <a href={record.repoUrl} target="_blank" rel="noopener">{record.title}</a>
      ) : (
        record.title
      )}
    </h3>
    <div class="record-tagline">{record.tagline}</div>
    {record.repoUrl ? (
      <a href={record.repoUrl} target="_blank" rel="noopener" class="record-repo-btn">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        {record.repoLabel || "GitHub"}
      </a>
    ) : (
      <span class="record-badge-static">{record.repoLabel}</span>
    )}
  </div>

  <div class="record-detail">
    <p class="record-desc">{record.description}</p>
    <div class="record-specs">
      {record.specs.map((s) => (
        <span class="spec-item">{s}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .record-entry {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px dashed var(--border-dark);
    position: relative;
  }

  .record-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .record-entry.featured {
    background: rgba(243, 239, 232, 0.5);
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.25rem 1.5rem 1.25rem;
    border-bottom: 1px solid var(--border-dark);
  }

  .record-meta h3 {
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.3rem;
  }

  .record-meta h3 a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-dark);
    padding-bottom: 1px;
  }

  .record-meta h3 a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .record-tagline {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: var(--text-muted);
    margin-bottom: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .record-repo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--border-dark);
    padding: 0.25rem 0.55rem;
    background: var(--bg);
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .record-repo-btn:hover {
    background: var(--surface);
    border-color: var(--accent);
    color: var(--accent-hover);
  }

  .record-badge-static {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    border: 1px solid var(--border-dark);
    padding: 0.25rem 0.55rem;
    background: var(--bg);
  }

  .record-detail {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .record-desc {
    font-size: 0.98rem;
    color: var(--text-soft);
    line-height: 1.62;
  }

  .record-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .spec-item {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
  }

  @media (max-width: 768px) {
    .record-entry { grid-template-columns: 1fr; gap: 0.6rem; }
  }
</style>
