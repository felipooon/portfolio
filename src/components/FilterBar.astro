---
interface Props {
  totalCount?: number;
}

const { totalCount = 6 } = Astro.props;
---

<div class="filter-strip">
  <span class="filter-label">Filtrar por área:</span>
  <div class="filter-tabs" role="tablist">
    <button class="filter-tab-item active" data-filter="all" type="button" role="tab" aria-selected="true">
      Todos
    </button>
    <button class="filter-tab-item" data-filter="web" type="button" role="tab" aria-selected="false">
      Web &amp; E-Commerce
    </button>
    <button class="filter-tab-item" data-filter="data" type="button" role="tab" aria-selected="false">
      Cartografía
    </button>
    <button class="filter-tab-item" data-filter="iot" type="button" role="tab" aria-selected="false">
      Hardware &amp; IoT
    </button>
  </div>
</div>

<script>
  function setupFilterBar() {
    const filterTabs = document.querySelectorAll('.filter-tab-item');
    const items = document.querySelectorAll<HTMLElement>('[data-category-key]');
    const platesSection = document.getElementById('proyectos');
    const recordsSection = document.getElementById('archivo');

    if (!filterTabs.length) return;

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = (tab as HTMLElement).dataset.filter || 'all';

        filterTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        let visiblePlates = 0;
        let visibleRecords = 0;

        items.forEach((item) => {
          const itemKey = item.dataset.categoryKey;
          const match = filter === 'all' || itemKey === filter;

          if (match) {
            item.style.display = '';
            if (item.classList.contains('editorial-plate')) visiblePlates++;
            if (item.classList.contains('record-entry')) visibleRecords++;
          } else {
            item.style.display = 'none';
          }
        });

        if (platesSection) platesSection.style.display = visiblePlates > 0 ? '' : 'none';
        if (recordsSection) recordsSection.style.display = visibleRecords > 0 ? '' : 'none';
      });
    });
  }

  setupFilterBar();
  document.addEventListener('astro:page-load', setupFilterBar);
</script>

<style>
  .filter-strip {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .filter-label {
    color: var(--text-muted);
  }

  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-tab-item {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-tab-item:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .filter-tab-item.active {
    background: var(--surface);
    color: var(--text);
    border-color: var(--text);
    font-weight: 700;
  }
</style>
