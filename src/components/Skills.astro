---
const SKILLS_DATA = [
  {
    area: "Backend & Datos",
    description: "Desarrollo de servicios, APIs y modelos relacionales",
    tools: ["Python", "Django", "Django REST Framework", "PostgreSQL", "SQLite", "iCalendar (RFC 5545)", "xhtml2pdf"]
  },
  {
    area: "Frontend & UI",
    description: "Arquitecturas web estáticas e interfaces interactivas",
    tools: ["Astro", "TypeScript", "JavaScript", "HTML & CSS", "Tailwind CSS", "Leaflet JS"]
  },
  {
    area: "Hardware & Terreno",
    description: "Sistemas embebidos y muestreo acústico pasivo (PAM)",
    tools: ["MicroPython", "Raspberry Pi Pico (RP2040)", "ESP32", "Micrófonos MEMS / I2S", "LiFePO4 Power Mgmt"]
  },
  {
    area: "Entorno & Despliegue",
    description: "Infraestructura, control de versiones y servidores",
    tools: ["Linux VPS", "Git & GitHub", "Nginx", "Render Cloud", "Vercel", "SSH"]
  }
];
---

<section id="tecnologias" class="skills-block">
  <div class="section-label-bar">
    <h2 class="section-heading">Tecnologías &amp; Herramientas</h2>
    <span class="section-meta-id">[ Stack ]</span>
  </div>

  <div class="skills-matrix">
    {SKILLS_DATA.map((row) => (
      <div class="matrix-row">
        <div class="matrix-label-col">
          <h3 class="area-name">{row.area}</h3>
          <p class="area-desc">{row.description}</p>
        </div>
        <div class="matrix-tags-col">
          {row.tools.map((item) => (
            <span class="tool-chip">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-block {
    margin-bottom: 5.5rem;
  }

  .skills-matrix {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface-card);
  }

  .matrix-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2rem;
    padding: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--border);
    align-items: center;
  }

  .matrix-row:last-child {
    border-bottom: none;
  }

  .area-name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .area-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .matrix-tags-col {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tool-chip {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-soft);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    transition: all 0.15s ease;
  }

  .tool-chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  @media (max-width: 768px) {
    .matrix-row {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.25rem;
    }
  }
</style>
