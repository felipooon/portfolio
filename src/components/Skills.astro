---
const STACK = [
  {
    category: "Backend & Web",
    items: ["Python", "Django", "Django REST Framework", "PostgreSQL", "SQLite"]
  },
  {
    category: "Frontend & UI",
    items: ["Astro", "TypeScript", "JavaScript", "HTML & CSS", "Tailwind CSS"]
  },
  {
    category: "Hardware & Terreno",
    items: ["MicroPython", "Raspberry Pi Pico (RP2040)", "ESP32", "Sensores I2S / MEMS"]
  },
  {
    category: "Herramientas & Despliegue",
    items: ["Linux", "Git & GitHub", "Nginx", "Render", "Vercel"]
  }
];
---

<section id="competencias" class="skills-section">
  <div class="section-bar">
    <h2>Herramientas &amp; Tecnologías</h2>
    <span class="folio-num">[ Folio 05 &ndash; Stack ]</span>
  </div>

  <div class="skills-container">
    {STACK.map((group) => (
      <div class="skill-row">
        <span class="skill-category">{group.category}</span>
        <div class="skill-tags">
          {group.items.map((item) => (
            <span class="skill-tag">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-section {
    margin-bottom: 4.5rem;
  }

  .skills-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border-dark);
    padding: 1.5rem;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px dotted var(--border);
  }

  .skill-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .skill-category {
    font-family: var(--font-title);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-soft);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .skill-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .skills-container { padding: 1.25rem; }
    .skill-row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
