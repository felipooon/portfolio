---
const SKILL_DOMAINS = [
  {
    code: "DOM-01",
    title: "Backend & Arquitectura",
    focus: "Sistemas distribuidos, persistencia y APIs de producción",
    skills: [
      { name: "Python 3 & Django 4.x", level: "Avanzado" },
      { name: "Django REST Framework", level: "APIs & Auth" },
      { name: "PostgreSQL & Modelado Relacional", level: "Producción" },
      { name: "Linux Server & Nginx VPS", level: "Despliegue" },
      { name: "Generación de Documentos (xhtml2pdf)", level: "Clínico" },
      { name: "Integraciones (Twilio, iCalendar)", level: "Servicios" }
    ]
  },
  {
    code: "DOM-02",
    title: "Frontend & Diseño Editorial",
    focus: "Rendimiento óptimo, tipografía cuidada e interfaces accesibles",
    skills: [
      { name: "Astro (SSG & Componentes Islas)", level: "Avanzado" },
      { name: "TypeScript & JavaScript ES6+", level: "Estructurado" },
      { name: "CSS Moderno, Grid & Flexbox", level: "Pixel-Perfect" },
      { name: "Tailwind CSS & CSS Modules", level: "Sistemas UI" },
      { name: "Optimización de Rendimiento & SEO", level: "100 Score" },
      { name: "Diseño Responsivo & Adaptabilidad", level: "Multi-pantalla" }
    ]
  },
  {
    code: "DOM-03",
    title: "IoT & Sistemas de Campo",
    focus: "Hardware embebido para monitoreo ambiental y bioacústica",
    skills: [
      { name: "MicroPython & C/C++ Embebido", level: "Firmware" },
      { name: "Raspberry Pi Pico (RP2040)", level: "Ultra Low Power" },
      { name: "ESP32 & Módems LTE 4G (SIM7600)", level: "Telemetría" },
      { name: "Protocolo MQTT & TLS Remoto", level: "Mensajería" },
      { name: "Audio Digital MEMS / I2S", level: "Bioacústica" },
      { name: "Alimentación Solar & LiFePO4", level: "Autonomía" }
    ]
  },
  {
    code: "DOM-04",
    title: "Cartografía, Datos & DevOps",
    focus: "Visualización geoespacial interactiva y flujos de despliegue",
    skills: [
      { name: "Leaflet JS & GeoJSON", level: "Cartografía" },
      { name: "APIs Geoespaciales & eBird 2.0", level: "Tiempo Real" },
      { name: "OpenStreetMap & Capas Vectoriales", level: "Satelital" },
      { name: "Git & GitHub Actions CI/CD", level: "Automatización" },
      { name: "Render, Vercel & GitHub Pages", level: "Infraestructura" },
      { name: "Series Temporales (InfluxDB)", level: "Telemetría" }
    ]
  }
];
---

<section id="competencias" class="skills-section">
  <div class="section-bar">
    <h2>Matriz de Competencias &amp; Dominio Técnico</h2>
    <span class="folio-num">[ Folio 05 &ndash; Capacidades ]</span>
  </div>

  <div class="skills-grid">
    {SKILL_DOMAINS.map((domain) => (
      <article class="skill-card">
        <div class="skill-card-top">
          <span class="skill-code">{domain.code}</span>
          <span class="skill-accent-bar"></span>
        </div>
        <h3 class="skill-card-title">{domain.title}</h3>
        <p class="skill-card-focus">{domain.focus}</p>
        
        <ul class="skill-item-list">
          {domain.skills.map((item) => (
            <li class="skill-item">
              <span class="skill-item-name">{item.name}</span>
              <span class="skill-item-tag">{item.level}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .skills-section {
    margin-bottom: 5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border-dark);
    padding: 1.5rem;
    position: relative;
    box-shadow: 0 4px 16px var(--shadow-color);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .skill-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--shadow-color);
  }

  .skill-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .skill-code {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .skill-accent-bar {
    width: 28px;
    height: 2px;
    background: var(--accent);
    opacity: 0.6;
  }

  .skill-card-title {
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .skill-card-focus {
    font-size: 0.88rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1.25rem;
    line-height: 1.45;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.65rem;
  }

  .skill-item-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: auto;
  }

  .skill-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-soft);
    padding-bottom: 0.3rem;
    border-bottom: 1px dotted var(--border);
  }

  .skill-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .skill-item-name {
    font-family: var(--font-serif);
  }

  .skill-item-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .skills-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
