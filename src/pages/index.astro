---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FilterBar from '../components/FilterBar.astro';
import Plate from '../components/Plate.astro';
import Skills from '../components/Skills.astro';
import RecordEntry from '../components/RecordEntry.astro';
import Contact from '../components/Contact.astro';
import Lightbox from '../components/Lightbox.astro';
import Footer from '../components/Footer.astro';
import { VISUAL_PLATES, TECHNICAL_RECORDS } from '../data/projects';

const totalRegistros = VISUAL_PLATES.length + TECHNICAL_RECORDS.length;
---

<Layout>
  <!-- FRONTISPICIO & CABECERA EDITORIAL -->
  <Header />

  <!-- FILTROS DE ARCHIVO Y CLASIFICACIÓN TÉCNICA -->
  <FilterBar totalCount={totalRegistros} />

  <!-- PROYECTOS PRINCIPALES: VISTAS Y CAPTURAS REALES -->
  <section id="proyectos" class="plates-section">
    <div class="section-bar">
      <h2>Proyectos &amp; Sistemas Principales</h2>
      <span class="folio-num">[ Folio 01 &ndash; 04 ]</span>
    </div>

    <div class="plates-grid">
      {VISUAL_PLATES.map((plate) => (
        <Plate plate={plate} />
      ))}
    </div>
  </section>

  <!-- MATRIZ DE COMPETENCIAS & STACK TÉCNICO -->
  <Skills />

  <!-- ARCHIVO TÉCNICO Y OTROS DESARROLLOS -->
  <section id="archivo" class="records-section">
    <div class="section-bar">
      <h2>Archivo de Desarrollos Técnicos</h2>
      <span class="folio-num">[ Folio 06 &ndash; 07 ]</span>
    </div>

    <div class="record-index">
      {TECHNICAL_RECORDS.map((record) => (
        <RecordEntry record={record} />
      ))}
    </div>
  </section>

  <!-- CORRESPONDENCIA & CONTACTO DIRECTO -->
  <Contact />

  <!-- COLOFÓN / PIE DE PÁGINA -->
  <Footer />

  <!-- VISOR DE LÁMINAS / LIGHTBOX -->
  <Lightbox />
</Layout>

<style>
  .plates-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }

  .record-index {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (max-width: 768px) {
    .plates-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
