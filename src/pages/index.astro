---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FilterBar from '../components/FilterBar.astro';
import Plate from '../components/Plate.astro';
import Skills from '../components/Skills.astro';
import RecordEntry from '../components/RecordEntry.astro';
import Contact from '../components/Contact.astro';
import Lightbox from '../components/Lightbox.astro';
import Footer from '../components/Footer.astro';
import { VISUAL_PLATES, TECHNICAL_RECORDS } from '../data/projects';

const totalRegistros = VISUAL_PLATES.length + TECHNICAL_RECORDS.length;
---

<Layout>
  <!-- INTRODUCCIÓN PRINCIPAL -->
  <Header />

  <!-- PROYECTOS PRINCIPALES CON CAPTURAS Y DETALLE -->
  <section id="proyectos" class="projects-section">
    <div class="section-label-bar">
      <h2 class="section-heading">Proyectos Desarrollados</h2>
      <span class="section-meta-id">[ Selección de Software ]</span>
    </div>

    <!-- FILTRO DE PROYECTOS -->
    <FilterBar totalCount={totalRegistros} />

    <!-- GRID DE PROYECTOS -->
    <div class="projects-grid">
      {VISUAL_PLATES.map((plate) => (
        <Plate plate={plate} />
      ))}
    </div>
  </section>

  <!-- MATRIZ DE COMPETENCIAS TÉCNICAS -->
  <Skills />

  <!-- ARCHIVO TÉCNICO Y SISTEMAS ADICIONALES -->
  <section id="archivo" class="archive-section">
    <div class="section-label-bar">
      <h2 class="section-heading">Archivo de Desarrollos Técnicos</h2>
      <span class="section-meta-id">[ Sistemas &amp; Firmware ]</span>
    </div>

    <div class="records-stack">
      {TECHNICAL_RECORDS.map((record) => (
        <RecordEntry record={record} />
      ))}
    </div>
  </section>

  <!-- FORMULARIO & SECCIÓN DE CONTACTO -->
  <Contact />

  <!-- PIE DE PÁGINA -->
  <Footer />

  <!-- VISOR DE CAPTURAS -->
  <Lightbox />
</Layout>

<style>
  .projects-section {
    margin-bottom: 5.5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .archive-section {
    margin-bottom: 5.5rem;
  }

  .records-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (max-width: 800px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
